<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>ar.edu</groupId>
    <artifactId>mediconecta</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>war</packaging>

    <name>MediConecta</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <jacoco.version>0.8.16</jacoco.version>
        <pitest.version>1.30.1</pitest.version>

        <!--
          Umbrales que verifica el build (mvn verify y PIT), sobre la capa de negocio y dominio
          (paquetes modelo y negocio): los mínimos del Eje B de los criterios de testing, 80 % de
          líneas, 70 % de ramas y 60 % de mutantes muertos en el paquete de dominio. Si un cambio los
          baja, el pipeline falla. Alcanzado el 18/11: 85 % de líneas, 84 % de ramas y 73 % de mutantes.
        -->
        <cobertura.lineas.minima>0.80</cobertura.lineas.minima>
        <cobertura.ramas.minima>0.70</cobertura.ramas.minima>
        <mutacion.minima>60</mutacion.minima>

        <!-- Análisis estático en SonarCloud: lo corre el pipeline cuando el repositorio tiene el secreto SONAR_TOKEN. -->
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.organization>toxicwork</sonar.organization>
        <sonar.projectKey>ToxicWork_MediConecta</sonar.projectKey>
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <!-- El cliente SOAP lo genera wsimport a partir del WSDL: no es código del equipo. -->
        <sonar.exclusions>**/integracion/obrasocial/soap/**</sonar.exclusions>
        <!--
          La cobertura que mide Sonar (y la que exige su Quality Gate en el código nuevo) es la de la capa de negocio y
          dominio, la misma del umbral del Eje B en JaCoCo. Las pantallas, la API, los DAO, las integraciones, la
          mensajería y la seguridad se prueban de punta a punta (pruebas/*.py), no con pruebas unitarias. Tampoco cuentan
          para la cobertura los scripts del pipeline, las pruebas de punta a punta, los simuladores ni la web estática
          (Sonar sí los analiza por bugs y seguridad). La cobertura de todo el código igual queda en el resumen de cada run.
        -->
        <sonar.coverage.exclusions>**/web/**,**/api/**,**/dao/**,**/integracion/**,**/mensajeria/**,**/notificaciones/**,**/seguridad/**,**/auditoria/**,src/main/webapp/**,.github/**,pruebas/**,sistemas-externos/**,docs/**</sonar.coverage.exclusions>
    </properties>

    <dependencies>

        <!-- Jakarta EE 10 - provisto por WildFly -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <version>10.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- PrimeFaces -->
        <dependency>
            <groupId>org.primefaces</groupId>
            <artifactId>primefaces</artifactId>
            <version>14.0.0</version>
            <classifier>jakarta</classifier>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.3</version>
            <scope>test</scope>
        </dependency>

        <!--
          Dobles de prueba para los EJB de negocio (sus DAO y colaboradores), sin contenedor. Con el mock maker de
          subclases (src/test/resources/mockito-extensions): no necesita adjuntar un agente a la JVM.
        -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.24.0</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <finalName>mediconecta</finalName>

        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
            </plugin>

            <!--
              Cliente SOAP del sistema legado de la obra social, generado con wsimport a partir del
              contrato (src/main/resources/wsdl/CoberturaService.wsdl). Las clases generadas quedan en
              target/generated-sources y nunca se usan fuera del adaptador CoberturaSoapAdapter.
            -->
            <plugin>
                <groupId>com.sun.xml.ws</groupId>
                <artifactId>jaxws-maven-plugin</artifactId>
                <version>4.0.3</version>
                <executions>
                    <execution>
                        <id>wsimport-obra-social</id>
                        <goals>
                            <goal>wsimport</goal>
                        </goals>
                        <configuration>
                            <wsdlDirectory>${project.basedir}/src/main/resources/wsdl</wsdlDirectory>
                            <wsdlFiles>
                                <wsdlFile>CoberturaService.wsdl</wsdlFile>
                            </wsdlFiles>
                            <wsdlLocation>/wsdl/CoberturaService.wsdl</wsdlLocation>
                            <packageName>ar.edu.mediconecta.integracion.obrasocial.soap</packageName>
                            <xnocompile>true</xnocompile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!--
              Cobertura de las pruebas unitarias. El reporte (target/site/jacoco) abarca todo el código
              del equipo; el control de umbrales, sólo la capa de negocio y dominio.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <exclude>ar/edu/mediconecta/integracion/obrasocial/soap/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>agente</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>reporte</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>umbrales-negocio-y-dominio</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>ar/edu/mediconecta/modelo/**</include>
                                <include>ar/edu/mediconecta/negocio/**</include>
                            </includes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${cobertura.lineas.minima}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${cobertura.ramas.minima}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              Pruebas de mutación sobre el paquete de dominio (modelo): entidades y patrón State.
              No está atado a ninguna fase; se corre con
              mvn test-compile org.pitest:pitest-maven:mutationCoverage
            -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.3</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>ar.edu.mediconecta.modelo.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>ar.edu.mediconecta.*</param>
                    </targetTests>
                    <mutationThreshold>${mutacion.minima}</mutationThreshold>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                    <threads>4</threads>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <profiles>
        <!--
          OWASP Dependency-Check (prometido en el documento de diseño): falla si una dependencia del WAR tiene una CVE
          de CVSS 7 o más (alta o crítica) sin una supresión justificada en dependency-check-supresiones.xml. Usa la
          base de vulnerabilidades de la NVD, que se descarga la primera vez (unos minutos) y después sólo se actualiza.
          Uso:  mvn -P dependencias verify -DskipTests
        -->
        <profile>
            <id>dependencias</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>12.1.9</version>
                        <configuration>
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                            <suppressionFiles>
                                <suppressionFile>${project.basedir}/dependency-check-supresiones.xml</suppressionFile>
                            </suppressionFiles>
                            <!--
                              La base de la NVD sale de la copia que publica el propio proyecto Dependency-Check en GitHub
                              Pages (un archivo por año): sin clave, la API de la NVD tarda más de una hora la primera vez.
                            -->
                            <nvdDatafeedUrl>https://dependency-check.github.io/DependencyCheck_Builder/nvd_cache/nvdcve-{0}.json.gz</nvdDatafeedUrl>
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                            </formats>
                            <!-- Sólo Java: OSS Index ahora exige credenciales y el proyecto no tiene JavaScript de npm. -->
                            <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                            <retireJsAnalyzerEnabled>false</retireJsAnalyzerEnabled>
                            <nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
                            <nodeAuditAnalyzerEnabled>false</nodeAuditAnalyzerEnabled>
                            <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                            <nuspecAnalyzerEnabled>false</nuspecAnalyzerEnabled>
                            <nugetconfAnalyzerEnabled>false</nugetconfAnalyzerEnabled>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
          Pruebas de integración con dependencias reales (Arquillian, contenedor remoto): se despliegan en el WildFly
          que ya está levantado y usan su PostgreSQL y su broker Artemis, sin mocks. Están en src/it/java, así que la
          compilación y las pruebas de siempre no cambian. Requisito: WildFly levantado (perfil standalone-full) con
          mediconecta.war desplegado y la clave de cifrado configurada. Uso:  mvn -P integracion verify
        -->
        <profile>
            <id>integracion</id>
            <dependencyManagement>
                <dependencies>
                    <dependency>
                        <groupId>org.jboss.arquillian</groupId>
                        <artifactId>arquillian-bom</artifactId>
                        <version>1.9.3.Final</version>
                        <type>pom</type>
                        <scope>import</scope>
                    </dependency>
                </dependencies>
            </dependencyManagement>
            <dependencies>
                <dependency>
                    <groupId>org.jboss.arquillian.junit5</groupId>
                    <artifactId>arquillian-junit5-container</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.wildfly.arquillian</groupId>
                    <artifactId>wildfly-arquillian-container-remote</artifactId>
                    <version>5.1.0.Final</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <!-- Pruebas de la API desde afuera (eje B): ApiRestAssuredIT -->
                    <groupId>io.rest-assured</groupId>
                    <artifactId>rest-assured</artifactId>
                    <version>5.5.6</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>fuentes-de-integracion</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/it/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>recursos-de-integracion</id>
                                <phase>generate-test-resources</phase>
                                <goals>
                                    <goal>add-test-resource</goal>
                                </goals>
                                <configuration>
                                    <resources>
                                        <resource>
                                            <directory>src/it/resources</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.2.5</version>
                        <configuration>
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>