<?xml version="1.0" encoding="UTF-8"?>
<web-app
    version="6.0"
    xmlns="https://jakarta.ee/xml/ns/jakartaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd">

  <display-name>MediConecta</display-name>

  <!-- Los comentarios de las páginas son para el equipo: no se envían al navegador (exponían detalles internos). -->
  <context-param>
    <param-name>jakarta.faces.FACELETS_SKIP_COMMENTS</param-name>
    <param-value>true</param-value>
  </context-param>

  <!--
    Content-Security-Policy de las páginas (Eje D). La pone PrimeFaces: genera un nonce por respuesta, se lo da a
    sus scripts y pasa los manejadores de eventos (onclick, oncomplete y los de JSF) a scripts con ese nonce, así
    no hace falta 'unsafe-inline' en script-src. PrimeFaces agrega el nonce al final de la política: por eso
    script-src va último. Los estilos en línea sí se permiten (PrimeFaces los usa); las fuentes son de Google.
  -->
  <context-param>
    <param-name>primefaces.CSP</param-name>
    <param-value>true</param-value>
  </context-param>
  <context-param>
    <param-name>primefaces.CSP_POLICY</param-name>
    <param-value>default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'; script-src 'self'</param-value>
  </context-param>

  <welcome-file-list>
    <welcome-file>login.xhtml</welcome-file>
  </welcome-file-list>

  <!--
    Cookie de sesión (prueba de seguridad SEC-W04):
    - HttpOnly: no es legible desde JavaScript (un XSS no la puede robar).
    - Secure: el navegador sólo la envía por HTTPS (no viaja en claro por la red).
    - SameSite=Lax: no se envía en pedidos que otro sitio dispara por detrás (formularios o imágenes de
      otro dominio), lo que corta los ataques CSRF; sí se envía al llegar a MediConecta desde un enlace.
      Strict obligaría a volver a iniciar sesión cada vez que se entra desde un enlace externo.
      Lo agrega WEB-INF/undertow-handlers.conf: Undertow (el servidor web de WildFly) no aplica el elemento
      <attribute> de cookie-config a la cookie de sesión.
    - El id de sesión nunca viaja en la URL (sólo cookie).
  -->
  <session-config>
    <cookie-config>
      <http-only>true</http-only>
      <secure>true</secure>
    </cookie-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>

  <!--
    Toda la aplicación por HTTPS: un pedido por http:// se redirige al puerto seguro (8443 en WildFly, con el
    certificado autofirmado que el servidor genera solo para localhost). Sin esto la cookie Secure no se
    enviaría y la sesión se perdería. No exige autenticación: eso lo decide MecanismoAutenticacion.
  -->
  <security-constraint>
    <web-resource-collection>
      <web-resource-name>Toda la aplicación por HTTPS</web-resource-name>
      <url-pattern>/*</url-pattern>
    </web-resource-collection>
    <user-data-constraint>
      <transport-guarantee>CONFIDENTIAL</transport-guarantee>
    </user-data-constraint>
  </security-constraint>

  <error-page>
    <error-code>500</error-code>
    <location>/error.xhtml</location>
  </error-page>
  <error-page>
    <exception-type>java.lang.Throwable</exception-type>
    <location>/error.xhtml</location>
  </error-page>

</web-app>
