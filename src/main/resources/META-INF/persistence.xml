<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="mediconectaPU" transaction-type="JTA">
        <jta-data-source>java:/mediconectaDS</jta-data-source>
        <properties>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <!--
              SQL de Hibernate apagado: con show_sql y format_sql el log tenía unas 44.500 líneas por corrida de
              pruebas y tapaba lo importante (avisos, integraciones, seguridad). Para depurar en una máquina, poner
              las dos en true; nunca muestra los valores (usa "?"), pero llena el log.
            -->
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
        </properties>
    </persistence-unit>

</persistence>
