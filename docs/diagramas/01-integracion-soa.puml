@startuml 01-integracion-soa
!include _estilo.iuml
title MediConecta — Arquitectura de integración (SOA) · Entrega Obligatoria N.º 2

actor "Paciente" as PAC
actor "Profesional" as PRO
actor "Partner / app externa" as EXTAPP

rectangle "MediConecta (WildFly 41 · Jakarta EE 10 · perfil standalone-full)" #F7F9FE {
  component "Presentación\nJSF + PrimeFaces\n(temas estándar / claro / oscuro)" as WEB
  component "API REST pública\n/api/v1 (JAX-RS)\nHTTP Basic" as API
  component "ServicioDeUsuarios\n<<Stateless>>" as SU
  component "ServicioDeTurnos\n<<Stateful>>" as ST
  component "ProcesoConfirmacionTurno\n<<Stateless>> CMT REQUIRED" as PCT
  component "ServicioDeAgenda\n<<Stateless>>" as SA
  component "ServicioDeHistoriaClinica\n<<Stateless>> @Auditado" as SHC
  component "ServicioDeObrasSociales\n<<Stateless>>\nCoberturaSoapAdapter" as SOS
  component "ServicioDePagos\n<<Stateless>>\nPasarelaPagosRestAdapter" as SP
  component "ServicioDeTelemedicina\n<<Stateless>>\nVideoconsultaRestAdapter" as STM
  component "ServicioDeNotificaciones\n<<MDB + Stateless>>" as SN
  component "Auditoría\n<<MDB>>" as AUD
  component "ServicioDeFacturacion\n<<MDB + Stateless>>" as SF
  component "AutorizacionConsumer\n<<MDB>> x2 sesiones" as AC

  queue "topico.turnos\n(pub/sub, durable)" as TOP #E5F7EC
  queue "cola.autorizaciones\n(punto a punto, TTL 24 h)" as COLA #E5F7EC
  queue "DLQ / ExpiryQueue" as DLQ #FDEAEA
}

database "Supabase\nPostgreSQL" as DB

rectangle "Sistemas externos (externos.war, simulados)" #FFF8EC {
  node "Obra social / prepaga\n(sistema LEGADO)\nCoberturaService?wsdl" as OS #FFF4E4
  node "Pasarela de pago\n(partner moderno)" as PG #FFF4E4
  node "Proveedor de video\n(partner moderno)" as VID #FFF4E4
}

PAC --> WEB : HTTP
PRO --> WEB : HTTP
EXTAPP --> API : REST / JSON
WEB --> ST : local (EJB)
WEB --> SU
WEB --> SHC
WEB --> STM
WEB --> SP
API --> SA : local (EJB)

ST --> PCT : confirmar()
PCT --> SOS : validarCobertura
PCT --> SP : cobrar (MANDATORY)
SOS --> OS : SOAP 1.1 / WSDL\nWS-Security UsernameToken\n(síncrono)
SP --> PG : REST / JSON\nBearer + Idempotency-Key\n(síncrono)
STM --> VID : REST / JSON\nX-Api-Key (síncrono)

PCT --> COLA : JMS send\n(misma transacción JTA)
PCT --> TOP : JMS publish TURNO_CONFIRMADO
ST --> TOP : TURNO_CANCELADO
COLA --> AC : JMS (competing consumers)
AC --> SOS : autorizar (@RunAs SISTEMA)
AC --> TOP : TURNO_AUTORIZADO /\nAUTORIZACION_RECHAZADA
TOP --> SN : durable
TOP --> AUD : durable
TOP --> SF : durable + selector\ntipoEvento IN (AUTORIZADO, CANCELADO)
SF --> SP : reintegro por cancelación
COLA --> DLQ : 8 intentos
TOP --> DLQ : 3 intentos

PCT --> DB : JPA (JTA)
SN --> DB
AUD --> DB
SF --> DB
AC --> DB

legend right
  |= Integración |= Tipo |= Por qué |
  | Obra social | sincrónica · SOAP | legado que sólo expone SOAP; el paciente necesita la cobertura para pagar |
  | Pasarela de pagos | sincrónica · REST | partner moderno; sin cobro no se confirma un turno con importe |
  | Videoconsulta | sincrónica · REST | la sala se necesita en el momento de entrar |
  | Autorizaciones | asincrónica · cola | cada solicitud una sola vez; el legado puede tardar o estar caído |
  | Eventos del turno | asincrónica · tópico | varios interesados que no se conocen entre sí |
  | API /api/v1 | sincrónica · REST | API de consumo externo para partners |
endlegend
@enduml
