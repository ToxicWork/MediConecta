{
  "openapi": "3.0.3",
  "info": {
    "title": "API REST de MediConecta",
    "version": "1.0.0",
    "description": "Turnos médicos: login con JWT, profesionales y su disponibilidad, y los turnos del usuario autenticado (consulta y cancelación). Los errores son Problem Details (RFC 9457, application/problem+json); cada código está explicado en docs/api/problemas.md. Lo verifica de punta a punta pruebas/prueba_contrato_api.py contra la aplicación desplegada."
  },
  "servers": [
    {"url": "https://localhost:8443/mediconecta/api/v1", "description": "WildFly local (certificado autofirmado)"}
  ],
  "tags": [
    {"name": "Autenticación"},
    {"name": "Profesionales", "description": "Públicos: no necesitan token."},
    {"name": "Turnos", "description": "Sólo los del usuario autenticado: un turno ajeno se responde como inexistente (404)."}
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Cambia email y contraseña por un token JWT (30 minutos)",
        "operationId": "login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Credenciales"}}}
        },
        "responses": {
          "200": {"description": "Ingreso correcto", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Token"}}}},
          "400": {"$ref": "#/components/responses/PedidoInvalido"},
          "401": {"$ref": "#/components/responses/CredencialesInvalidas"},
          "403": {"$ref": "#/components/responses/PasswordTemporal"},
          "415": {"$ref": "#/components/responses/TipoNoSoportado"},
          "422": {"$ref": "#/components/responses/DatosInvalidos"},
          "429": {"$ref": "#/components/responses/DemasiadosIntentos"}
        }
      }
    },
    "/profesionales": {
      "get": {
        "tags": ["Profesionales"],
        "summary": "Profesionales con su especialidad",
        "operationId": "listarProfesionales",
        "security": [],
        "responses": {
          "200": {"description": "Lista de profesionales", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Profesional"}}}}},
          "406": {"$ref": "#/components/responses/NoAceptable"}
        }
      }
    },
    "/profesionales/{id}/disponibilidad": {
      "get": {
        "tags": ["Profesionales"],
        "summary": "Horarios disponibles de un profesional, del más próximo al más lejano",
        "operationId": "disponibilidad",
        "security": [],
        "parameters": [{"$ref": "#/components/parameters/Id"}],
        "responses": {
          "200": {"description": "Horarios disponibles (vacío si no tiene)", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/TurnoDisponible"}}}}},
          "404": {"$ref": "#/components/responses/NoEncontrado"}
        }
      }
    },
    "/turnos": {
      "get": {
        "tags": ["Turnos"],
        "summary": "Turnos del usuario autenticado (paciente o profesional), sin datos clínicos",
        "operationId": "misTurnos",
        "responses": {
          "200": {"description": "Turnos del usuario", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Turno"}}}}},
          "401": {"$ref": "#/components/responses/NoAutenticado"},
          "403": {"$ref": "#/components/responses/Prohibido"}
        }
      },
      "delete": {
        "tags": ["Turnos"],
        "summary": "No existe: la colección no se borra",
        "operationId": "borrarTurnos",
        "responses": {"405": {"$ref": "#/components/responses/MetodoNoPermitido"}}
      }
    },
    "/turnos/{id}": {
      "get": {
        "tags": ["Turnos"],
        "summary": "Un turno del usuario, con su versión como ETag",
        "operationId": "turno",
        "parameters": [
          {"$ref": "#/components/parameters/Id"},
          {"name": "If-None-Match", "in": "header", "required": false, "description": "ETag que el cliente ya tiene: si no cambió, 304 sin cuerpo.", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "El turno", "headers": {"ETag": {"$ref": "#/components/headers/ETag"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Turno"}}}},
          "304": {"description": "No cambió desde el ETag indicado", "headers": {"ETag": {"$ref": "#/components/headers/ETag"}}},
          "401": {"$ref": "#/components/responses/NoAutenticado"},
          "403": {"$ref": "#/components/responses/Prohibido"},
          "404": {"$ref": "#/components/responses/NoEncontrado"},
          "406": {"$ref": "#/components/responses/NoAceptable"}
        }
      }
    },
    "/turnos/{id}/cancelacion": {
      "post": {
        "tags": ["Turnos"],
        "summary": "Cancela un turno confirmado (patrón State), con control de concurrencia e idempotencia",
        "description": "El paciente cancela los suyos, el profesional los de su agenda y el administrativo cualquiera. Sin cuerpo.",
        "operationId": "cancelar",
        "parameters": [
          {"$ref": "#/components/parameters/Id"},
          {"name": "If-Match", "in": "header", "required": false, "description": "ETag de la versión que el cliente vio: si el turno cambió, 412 y no se cancela.", "schema": {"type": "string"}},
          {"name": "Idempotency-Key", "in": "header", "required": false, "description": "Clave del cliente para reintentar sin cancelar dos veces: con la misma clave se repite la respuesta original (24 horas).", "schema": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,100}$"}}
        ],
        "responses": {
          "200": {
            "description": "Turno cancelado (o la misma respuesta de la primera vez, si se repite la Idempotency-Key)",
            "headers": {
              "ETag": {"$ref": "#/components/headers/ETag"},
              "Idempotent-Replayed": {"description": "true cuando es la repetición de un pedido ya hecho con la misma clave", "schema": {"type": "string", "enum": ["true"]}}
            },
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Turno"}}}
          },
          "400": {"$ref": "#/components/responses/PedidoInvalido"},
          "401": {"$ref": "#/components/responses/NoAutenticado"},
          "404": {"$ref": "#/components/responses/NoEncontrado"},
          "409": {"$ref": "#/components/responses/TransicionInvalida"},
          "412": {"$ref": "#/components/responses/PrecondicionFallida"},
          "422": {"$ref": "#/components/responses/ClaveReutilizada"}
        }
      }
    }
  },
  "security": [{"bearerAuth": []}],
  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT", "description": "Authorization: Bearer <token de /auth/login>"}
    },
    "parameters": {
      "Id": {"name": "id", "in": "path", "required": true, "schema": {"type": "integer", "format": "int64"}}
    },
    "headers": {
      "ETag": {"description": "Versión del turno entre comillas, por ejemplo \"3\"", "schema": {"type": "string", "pattern": "^\"[0-9]+\"$"}},
      "RetryAfter": {"description": "Segundos hasta poder volver a intentar", "schema": {"type": "integer", "minimum": 1}},
      "WWWAuthenticate": {"description": "Bearer (con error=\"invalid_token\" si el token no sirve)", "schema": {"type": "string", "pattern": "^Bearer"}}
    },
    "schemas": {
      "FechaHoraLocal": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?$", "description": "Fecha y hora local de Argentina, sin zona (ISO 8601)", "example": "2026-12-16T17:42:00"},
      "Credenciales": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {"email": {"type": "string", "example": "juan.perez@mediconecta.test"}, "password": {"type": "string", "format": "password"}}
      },
      "Token": {
        "type": "object",
        "additionalProperties": false,
        "required": ["token", "tipo", "expiraEnSegundos", "rol"],
        "properties": {
          "token": {"type": "string", "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"},
          "tipo": {"type": "string", "enum": ["Bearer"]},
          "expiraEnSegundos": {"type": "integer", "minimum": 1},
          "rol": {"type": "string", "enum": ["PACIENTE", "PROFESIONAL", "ADMINISTRATIVO"]}
        }
      },
      "Profesional": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nombre", "especialidad"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "nombre": {"type": "string"},
          "especialidad": {"type": "string"},
          "matricula": {"type": "string", "nullable": true}
        }
      },
      "TurnoDisponible": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fechaHora", "modalidad", "codigoPrestacion", "precioLista"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "fechaHora": {"$ref": "#/components/schemas/FechaHoraLocal"},
          "modalidad": {"$ref": "#/components/schemas/Modalidad"},
          "codigoPrestacion": {"type": "string"},
          "precioLista": {"type": "number", "minimum": 0}
        }
      },
      "Turno": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fechaHora", "modalidad", "estado", "profesional", "especialidad", "autorizacion"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "fechaHora": {"$ref": "#/components/schemas/FechaHoraLocal"},
          "modalidad": {"$ref": "#/components/schemas/Modalidad"},
          "estado": {"type": "string", "enum": ["DISPONIBLE", "HOLD", "CONFIRMADO", "CANCELADO"]},
          "profesional": {"type": "string"},
          "especialidad": {"type": "string"},
          "paciente": {"type": "string", "nullable": true},
          "cobertura": {"type": "string", "nullable": true, "enum": ["CUBIERTA", "PARTICULAR", "PENDIENTE", null]},
          "autorizacion": {"type": "string", "enum": ["NO_REQUIERE", "PENDIENTE", "AUTORIZADA", "RECHAZADA"]},
          "codigoAutorizacion": {"type": "string", "nullable": true},
          "importePaciente": {"type": "number", "nullable": true, "minimum": 0},
          "salaVideoconsulta": {"type": "string", "nullable": true, "description": "Enlace a la sala, sólo para quien participa del turno"}
        }
      },
      "Modalidad": {"type": "string", "enum": ["PRESENCIAL", "TELEMEDICINA"]},
      "Problema": {
        "type": "object",
        "description": "Problem Details (RFC 9457) más los campos de antes (estado, error, mensaje, fecha), que se mantienen por compatibilidad",
        "additionalProperties": false,
        "required": ["type", "title", "status", "estado", "error", "mensaje", "fecha"],
        "properties": {
          "type": {"type": "string", "pattern": "^https://github\\.com/ToxicWork/MediConecta/blob/main/docs/api/problemas\\.md#[a-z_]+$"},
          "title": {"type": "string"},
          "status": {"type": "integer", "minimum": 400, "maximum": 599},
          "detail": {"type": "string", "nullable": true},
          "instance": {"type": "string", "nullable": true},
          "estado": {"type": "integer", "minimum": 400, "maximum": 599},
          "error": {"type": "string", "enum": ["pedido_invalido", "no_autenticado", "token_invalido", "credenciales_invalidas", "prohibido", "password_temporal", "no_encontrado", "metodo_no_permitido", "no_aceptable", "transicion_invalida", "regla_de_negocio", "precondicion_fallida", "tipo_no_soportado", "datos_invalidos", "clave_reutilizada", "demasiados_intentos", "error_interno", "error_http"]},
          "mensaje": {"type": "string"},
          "fecha": {"$ref": "#/components/schemas/FechaHoraLocal"}
        }
      }
    },
    "responses": {
      "PedidoInvalido": {"description": "pedido_invalido: falta el cuerpo, no es JSON o una cabecera tiene mal el formato", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problema"}}}},
      "CredencialesInvalidas": {"description": "credenciales_invalidas: email o contraseña incorrectos (la misma respuesta para una cuenta que no existe)", "headers": {"WWW-Authenticate": {"$ref": "#/components/headers/WWWAuthenticate"}}, "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problema"}}}},
      "NoAutenticado": {"description": "no_autenticado (sin token) o token_invalido (vencido, adulterado u otro esquema)", "headers": {"WWW-Authenticate": {"$ref": "#/components/headers/WWWAuthenticate"}}, "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problema"}}}},
      "PasswordTemporal": {"description": "password_temporal: el usuario tiene que cambiar su contraseña temporal en la web", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problema"}}}},
      "Prohibido": {"description": "prohibido: el rol no alcanza", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problema"}}}},
      "NoEncontrado": {"description": "no_encontrado: no existe o no es del usuario", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problema"}}}},
      "MetodoNoPermitido": {"description": "metodo_no_permitido", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problema"}}}},
      "NoAceptable": {"description": "no_aceptable: el cliente pidió un formato que no hay (sólo JSON)", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problema"}}}},
      "TransicionInvalida": {"description": "transicion_invalida: la operación no vale en el estado del turno (patrón State)", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problema"}}}},
      "PrecondicionFallida": {"description": "precondicion_fallida: el If-Match no coincide con la versión actual", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problema"}}}},
      "TipoNoSoportado": {"description": "tipo_no_soportado: el cuerpo no es application/json", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problema"}}}},
      "DatosInvalidos": {"description": "datos_invalidos: falta el email o la contraseña", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problema"}}}},
      "ClaveReutilizada": {"description": "clave_reutilizada: la Idempotency-Key ya se usó en otro pedido", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problema"}}}},
      "DemasiadosIntentos": {"description": "demasiados_intentos: 5 fallos seguidos con ese email (vale igual para una cuenta que no existe)", "headers": {"Retry-After": {"$ref": "#/components/headers/RetryAfter"}}, "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problema"}}}}
    }
  }
}
